{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Celery Todo",
  "version": "3.0.0-alpha.1",
  "identifier": "com.celery.todo",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Celery Todo",
        "decorations": false,
        "visible": false,
        "width": 1100,
        "height": 750,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
