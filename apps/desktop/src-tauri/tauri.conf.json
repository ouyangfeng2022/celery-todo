{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Celery Todo",
  "version": "3.2.0",
  "identifier": "com.celery.todo",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Celery Todo",
        "decorations": false,
        "visible": false,
        "width": 1100,
        "height": 750,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ouyangfeng2022/celery-todo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyREVEMUEwRDg0RkFGRkMKUldUOHIwL1lvTkhlZ25oVFdrYzIrbngwMmMweVJrNW42dit2QnlqQU1WQXdwbmxZbzhveUVBY3oK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
