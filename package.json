{
  "name": "celery-todo",
  "private": true,
  "version": "3.4.2",
  "description": "Celery Todo monorepo（3.0 跨端：Tauri 桌面 + Expo 移动 + 共享核心）",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ouyangfeng2022/celery-todo.git"
  },
  "bugs": {
    "url": "https://github.com/ouyangfeng2022/celery-todo/issues"
  },
  "homepage": "https://github.com/ouyangfeng2022/celery-todo#readme",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.{ts,tsx,css}\"",
    "test": "turbo run test:run",
    "test:run": "turbo run test:run",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "desktop:dev": "bun run --filter @celery/desktop tauri:dev",
    "desktop:build": "bun run --filter @celery/desktop tauri:build",
    "check-repo": "node scripts/check-repo-health.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.8",
    "prettier": "^3.3.3",
    "sharp": "^0.35.3",
    "turbo": "^2.3.3"
  }
}
