{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test:run": {
      "outputs": []
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "cache": false
    },
    "tauri:dev": {
      "cache": false
    },
    "tauri:build": {
      "cache": false
    }
  }
}
